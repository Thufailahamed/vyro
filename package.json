{
  "name": "vyro",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @vyro/db migrate",
    "db:seed": "pnpm --filter @vyro/db seed",
    "db:studio": "pnpm --filter @vyro/db studio",
    "deploy:backend": "node scripts/deploy-backend.mjs",
    "deploy:backend:seed": "node scripts/deploy-backend.mjs --seed"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0",
    "eslint": "^9.13.0"
  }
}
