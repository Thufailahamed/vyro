# Copy to `.env` and adjust. EXPO_PUBLIC_* values are inlined at build time.

# Worker API base (must end in /api). Defaults to production when unset.
EXPO_PUBLIC_API_URL="https://vyro-api.thufailahamed627.workers.dev/api"

# Local Worker from a physical device: use your machine's LAN IP, not localhost.
# EXPO_PUBLIC_API_URL="http://192.168.1.20:8787/api"

# Public web origin, used for share links.
# EXPO_PUBLIC_WEB_URL="https://vyro-api.thufailahamed627.workers.dev"
