# Local web app env. Copy to `.env` (gitignored) and adjust.

# Base URL the SPA prefixes to every API call (see src/lib/api.ts).
#
# The value MUST include the "/api" segment — the API client appends the
# route to it verbatim, so "/ai/home" becomes "<VITE_API_URL>/ai/home".
#   unset        -> "/api"           (same-origin; correct for the Worker,
#                                    which serves the SPA and /api/* together)
#   "http://localhost:8787/api"     -> local Worker on another port
#
# Leave it unset for production/staging: the Worker serves the SPA and the
# API from a single origin, and a same-origin request keeps the session
# cookie first-party.
# VITE_API_URL="http://localhost:8787/api"

# Set to "1" to render the hardcoded demo content on MarketingPages.
# Leave unset / "0" for production / staging / audit builds.
VITE_DEMO_CONTENT="0"

# Optional analytics / observability.
# VITE_SENTRY_DSN=""
# VITE_PUBLIC_POSTHOG_KEY=""

# Cloudflare Web Analytics beacon token. Find at
# https://dash.cloudflare.com/?to=/:account/:zone/web-analytics
# Optional — unset to disable the beacon entirely.
# VITE_CF_ANALYTICS_BEACON="your-cf-web-analytics-token"
