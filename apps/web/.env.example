# Local web app env. Copy to `.env` (gitignored) and adjust.

# API base URL used by the SPA to call the backend.
VITE_API_BASE_URL="http://localhost:8787"

# Set to "1" to render the hardcoded demo content on MarketingPages.
# Leave unset / "0" for production / staging / audit builds.
VITE_DEMO_CONTENT="0"

# Optional analytics / observability.
# VITE_SENTRY_DSN=""
# VITE_PUBLIC_POSTHOG_KEY=""

# Cloudflare Web Analytics beacon token. Find at
# https://dash.cloudflare.com/?to=/:account/:zone/web-analytics
# Optional — unset to disable the beacon entirely.
# VITE_CF_ANALYTICS_BEACON="your-cf-web-analytics-token"
