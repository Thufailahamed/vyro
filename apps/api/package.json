{
  "name": "@vyro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --port 8787",
    "build": "tsc",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint stub'",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply vyro --local",
    "db:migrate:remote": "wrangler d1 migrations apply vyro --remote",
    "db:migrate:list": "wrangler d1 migrations list vyro --local",
    "audit:rbac": "node --experimental-strip-types src/scripts/rbac-audit.ts",
    "audit:secrets": "node --experimental-strip-types src/scripts/secret-scan.ts",
    "audit:deps": "node --experimental-strip-types src/scripts/dep-audit.ts"
  },
  "dependencies": {
    "@vyro/auth": "workspace:*",
    "@vyro/db": "workspace:*",
    "@vyro/payments": "workspace:*",
    "@vyro/shared": "workspace:*",
    "@vyro/validation": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "uuid": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.80.0"
  }
}
